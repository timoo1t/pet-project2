@startuml technical
title Техническая блок-схема quiz_app.py (квадраты и ромбики)

skinparam shadowing false
skinparam roundcorner 0
skinparam backgroundColor #F5F5F5
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam activityBackgroundColor #DAE8FC
skinparam activityBorderColor #6C8EBF
skinparam activityFontColor #333333
skinparam activityDiamondBackgroundColor #FFF2CC
skinparam activityDiamondBorderColor #D6B656
skinparam activityDiamondFontColor #333333
skinparam partitionBackgroundColor #FFFFFF
skinparam partitionBorderColor #23445D
skinparam arrowColor #6C8EBF
skinparam noteBackgroundColor #FFFFFF
skinparam noteBorderColor #6C8EBF

start

partition "Импорты" {
  :json, sys, threading, webbrowser;
  :datetime, pathlib.Path;
  :Flask, redirect, render_template;
  :request, session, url_for;
}

partition "Конфигурация" {
  :_resource_dir() и _writable_dir();
  :APP_DIR, DATA_DIR;
  :QUESTIONS_FILE, RESULTS_FILE;
  :создать Flask app;
  :template_folder, static_folder, secret_key;
}

partition "Данные (что хранится)" {
  note right
    questions.json
    Question: question, options, correct
    --
    SessionState: player_name, topic,
    index, score, total, answers
    AnswerRecord: question, chosen,
    correct, is_correct
    --
    results.txt — лог результатов
  end note
}

partition "Запуск __main__" {
  if (questions.json есть?) then (нет)
    stop
  else (да)
  endif
  :Timer открыть браузер;
  :app.run 127.0.0.1:5000;
}

partition "index — GET /" {
  :session.clear();
  :load_questions, get_topics;
  :показать index.html;
}

partition "start — POST /start" {
  :взять topic из формы;
  if (topic в списке тем?) then (нет)
    :редирект на /;
    stop
  else (да)
  endif
  :записать player_name в session;
  :topic, index=0, score=0;
  :answers=[], total=число вопросов;
  :редирект на /question;
}

partition "Цикл викторины" {
  repeat
    partition "question — GET /question" {
      if (topic в session?) then (нет)
        :редирект на /;
        stop
      else (да)
      endif
      :get_questions(topic);
      :idx = session.index;
      if (idx >= число вопросов?) then (да)
        :редирект на /result;
        break
      else (нет)
      endif
      :показать question.html;
    }

    partition "answer — POST /answer" {
      if (topic в session?) then (нет)
        :редирект на /;
        stop
      else (да)
      endif
      :idx = session.index;
      if (idx >= число вопросов?) then (да)
        :редирект на /result;
        stop
      else (нет)
      endif
      :chosen = ответ из формы;
      :сравнить с questions[idx].correct;
      if (ответ верный?) then (да)
        :score + 1;
      else (нет)
      endif
      :добавить AnswerRecord в answers;
      :index = idx + 1;
      :редирект на /question;
    }
  repeat while (index < total?) is (да)
  ->(нет);
}

partition "result — GET /result" {
  if (topic в session?) then (нет)
    :редирект на /;
    stop
  else (да)
  endif
  if (все ответы даны?) then (да)
    :save_result в results.txt;
  else (нет)
  endif
  :показать result.html и разбор;
}

partition "restart — GET /restart" {
  if (нужен новый тест?) then (да)
    :session.clear();
    :редирект на /;
    :снова index.html;
  else (нет)
  endif
}

stop

@enduml
