@startuml technical
title Техническая UML — сверху вниз (quiz_app.py)

top to bottom direction
skinparam shadowing false
skinparam nodesep 14
skinparam ranksep 20
skinparam classFontSize 10

class Imports {
  import json
  import sys
  import threading
  import webbrowser
  from datetime import datetime
  from pathlib import Path
  from flask import Flask
  from flask import redirect
  from flask import render_template
  from flask import request
  from flask import session
  from flask import url_for
}

class PathHelpers {
  + _resource_dir()
  + _writable_dir()
}

class Paths {
  APP_DIR
  DATA_DIR
  QUESTIONS_FILE
  RESULTS_FILE
}

class FlaskApp {
  template_folder
  static_folder
  secret_key
}

class Question {
  question
  options
  correct
}

class AnswerRecord {
  question
  chosen
  correct
  is_correct
}

class SessionState {
  player_name
  topic
  index
  score
  total
  answers
}

class questions_json <<storage>> {
  topics to Question[]
}

class results_txt <<storage>> {
  append log line
}

class DataFunctions {
  + load_questions()
  + get_topics()
  + get_questions(topic)
  + save_result(name, topic, score, total)
}

class QuizRoutes {
  + index() GET /
  + start() POST /start
  + question() GET /question
  + answer() POST /answer
  + result() GET /result
  + restart() GET /restart
}

class Templates {
  base.html
  index.html
  question.html
  result.html
}

class style_css <<static>> {
  style.css
}

class Main {
  + __main__
  check QUESTIONS_FILE
  Timer webbrowser
  app.run()
}

class CycleStart {
  1 POST /start
  2 check topic
  3 fill SessionState
  4 redirect /question
}

class CycleLoop {
  5 GET /question
  6 check topic
  7 read index
  8 if index >= len goto result
  9 render question.html
  10 POST /answer
  11 parse chosen
  12 compare correct
  13 update score
  14 append AnswerRecord
  15 index increment
  16 redirect /question
  17 WHILE index < total goto 5
}

class CycleEnd {
  18 GET /result
  19 save_result if done
  20 render result.html
  21 GET /restart optional
  22 session.clear
}

Imports -down-> PathHelpers
PathHelpers -down-> Paths
Paths -down-> FlaskApp

FlaskApp -down-> Question
Question -down-> AnswerRecord
AnswerRecord -down-> SessionState

SessionState -down-> questions_json
questions_json -down-> results_txt
results_txt -down-> DataFunctions

DataFunctions -down-> QuizRoutes
QuizRoutes -down-> Templates
Templates -down-> style_css
style_css -down-> Main

Main -down-> CycleStart
CycleStart -down-> CycleLoop
CycleLoop -down-> CycleEnd

SessionState *-- AnswerRecord
questions_json *-- Question
DataFunctions ..> questions_json
DataFunctions ..> results_txt
QuizRoutes ..> DataFunctions
QuizRoutes ..> SessionState
QuizRoutes ..> Templates
QuizRoutes ..> FlaskApp
Main ..> FlaskApp

@enduml
